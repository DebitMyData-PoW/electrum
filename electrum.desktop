# If you want DebitMyData-Electrum to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum.desktop
# Note: This assumes $HOME/.local/bin is in your $PATH

[Desktop Entry]
Comment=Lightweight DebitMyData Client
Exec=electrum %u
GenericName[en_US]=DebitMyData Wallet
GenericName=DebitMyData Wallet
Icon=electrum
Name[en_US]=DebitMyData Electrum Wallet
Name=DebitMyData Electrum Wallet
Categories=Finance;Network;
StartupNotify=true
StartupWMClass=electrum
Terminal=false
Type=Application
MimeType=x-scheme-handler/debitmydata;
Keywords=crypto;currency;DMD;DebitMyData
